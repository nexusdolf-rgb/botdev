# Hoxera — variables d'environnement (ne jamais committer le vrai fichier .env)
PORT=3000
NODE_ENV=production
PUBLIC_ORIGIN=https://hoxera.is-a.dev
# Sur un hébergement avec disque persistant, indique un répertoire réservé :
# BOTDEV_DATA_DIR=/chemin/persistant/hoxera

# Bot Discord principal
HOXERA_TOKEN=
HOXERA_CLIENT_ID=

# Connexion OAuth2 Discord (callback à enregistrer dans le portail développeur)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://hoxera.is-a.dev/api/auth/discord/callback

# Identifiant Discord du fondateur (fail-closed si absent/invalide en production)
NEXORA_ADMIN_DISCORD_ID=

# Chiffrement AES-256-GCM des tokens en base SQLite.
# Génère une clé stable de 64 caractères hexadécimaux : openssl rand -hex 32
# Garde-la hors du dépôt et ne la change pas sans plan de rotation.
# Si l'instance a déjà chiffré des données avec le secret OAuth, renseigne
# temporairement l'ancienne clé dans BOTDEV_DATA_ENCRYPTION_KEY_PREVIOUS.
BOTDEV_DATA_ENCRYPTION_KEY=
BOTDEV_DATA_ENCRYPTION_KEY_PREVIOUS=

# Sauvegarde de la base dans un dépôt GitHub privé (fine-grained PAT,
# Contents: Read/Write, limité au seul dépôt de données).
BOTDEV_GH_TOKEN=
BOTDEV_DATA_REPO=
BOTDEV_DATA_BRANCH=
